# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitesync?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==============================================================================
# MULTI-TIER TRANSLATION ENGINES (7-Tier Fallback Chain)
# ==============================================================================

# Tier 1: Self-Hosted NLLB-600M FastAPI Server (Optional Docker / Local)
NLLB_SERVER_URL="http://localhost:8000"
NLLB_API_KEY="nllb_secret_key_123"

# Tier 2A: DeepSeek-V3 API (Top Chinese Translation Model at https://platform.deepseek.com)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# Tier 2B: Alibaba Qwen API (DashScope OpenAI Compatible Mode at https://dashscope.console.aliyun.com)
QWEN_API_KEY="sk-your-qwen-api-key"

# Tier 2C: Groq Cloud Free Llama-3 70B API (Free fast AI inference at https://console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Tier 2D: OpenAI GPT-4o-mini API (https://platform.openai.com)
OPENAI_API_KEY="sk-proj-your-openai-key-here"

# Tier 3: Hugging Face Free Token for Meta NLLB-200 (https://huggingface.co/settings/tokens)
HF_TOKEN="hf_your_huggingface_token_here"

# Tier 4: DeepL Free API Key (500k chars/mo at https://www.deepl.com/pro-api)
DEEPL_API_KEY="your-deepl-api-key-here:fx"

# Tier 5: MyMemory Free Email for 10k words/day quota (https://mymemory.translated.net)
MYMEMORY_EMAIL="your_email@domain.com"

# Pusher WebSockets for Real-time Group Chat (https://pusher.com)
PUSHER_APP_ID="your_pusher_app_id"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
