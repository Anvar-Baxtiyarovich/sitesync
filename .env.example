# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitesync?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# NLLB-200 Server for local / remote translation (Zero-cost option 1)
NLLB_SERVER_URL="http://localhost:8000"
NLLB_API_KEY="nllb_secret_key_123"

# HuggingFace Free Inference API for Translation (Zero-cost option 2)
# HF_TOKEN="your_hf_token_here"

# Pusher WebSockets for Real-time Chat
PUSHER_APP_ID="your_pusher_app_id"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# Optional Cloud API Fallbacks (OpenAI / DeepL)
OPENAI_API_KEY="sk-proj-your-openai-key-here"
DEEPL_API_KEY="your-deepl-api-key-here"

# NextAuth Configuration
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"
