{
  "appId": "com.sitesync.app",
  "appName": "SiteSync",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://sitesync-anvar-baxtiyarovichs-projects.vercel.app",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#0f172a"
  },
  "ios": {
    "scrollEnabled": true,
    "backgroundColor": "#0f172a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    }
  }
}
